  "steps": [
    {
      "step": "Preheat the oven to 200°C"
    },
    {
      "step": "Add all the dry ingredients to a bowl and mix them. (Flour, Baking powder, Salt, Cinnamon, Vanilla sugar)"
    },
    {
      "step": "Make a hole in the middle of the dry ingredients and add the rest of the ingredients except for the blueberries. (Olive oil, Eggs, Greek yoghurt) Mix thoroughly."
    },
    {
      "step": "Add the blueberries and gently mix them through the mixture."
    },
    {
      "step": "Divide the mixture over a buttered muffin pan. Bake for 16-20 minutes."
    }
