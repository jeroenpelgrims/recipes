  "steps": [
    {
      "step": "Make the sauce by combining the following ingredients in a bowl:\nFish sauce, Soy sauce, Brown sugar, Tamarind paste, Sriracha sauce, peanut butter\n"
    },
    {
      "step": "Cook the noodles. They should still be a bit chewy. It should take between 1 and 3 minutes.\nImmediately after cooking them, rinse with cold water. This prevents them from continuing to soften.\n"
    },
    {
      "step": "Heat about 3/4ths of the oil in a pan."
    },
    {
      "step": "Add shrimp, garlic, bell pepper. Cook it for a few minutes."
    },
    {
      "step": "Make some space in the pan. Add the rest of the oil. Add the eggs and scramble them."
    },
    {
      "step": "Add the noodles and pour the sauce over them to loosen them up again. Add the bean sprouts."
    },
    {
      "step": "Cook a bit more until everything is heated up and the bean sprouts have softened"
    },
    {
      "step": "Garnish with some green onions, chopped peanuts, cilantro and drizzle some lime juice over it."
    }
  ]
