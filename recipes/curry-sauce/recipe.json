  "steps": [
    {
      "step": "Heat the oil in a pan"
    },
    {
      "step": "Add the garlic, onion, and ginger. Cook until soft. Don't let it brown."
    },
    {
      "step": "Add the curry powder, chili flakes and tomato paste. Cook until the tomato paste looks glossy."
    },
    {
      "step": "Add the sugar, salt, pepper and the cream. Cook until the sauce thickens."
    },
    {
      "step": "Cook any other ingredients you want to add in the sauce like chicken, tofu, or vegetables."
    },
    {
      "step": "Add the cooked ingredients to the sauce and serve with rice or naan bread."
    }
