  "steps": [
    {
      "step": "Heat the olive oil in a large pan on medium heat. Add the chopped onion and bell pepper. Cook for 5 minutes or until the onion becomes translucent."
    },
    {
      "step": "Add the garlic, cumin, paprika powder and chili powder."
    },
    {
      "step": "Add the can of tomatoes and break them apart. Season with salt and pepper."
    },
    {
      "step": "Bring the sauce to a simmer."
    },
    {
      "step": "Make wells into the sauce and crack the eggs into them."
    },
    {
      "step": "Cover the pan and cook until the eggs are done (5-8 minutes)."
    },
    {
      "step": "Garnish with parsley and cilantro."
    }
  ]
